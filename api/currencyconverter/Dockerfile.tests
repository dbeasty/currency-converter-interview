FROM python:3.12-slim
WORKDIR /tests

# Install performance test dependencies (locust).
# Integration tests use stdlib only — no extra packages needed.
COPY performance_tests/requirements.txt performance_tests/requirements.txt
RUN pip install --no-cache-dir -r performance_tests/requirements.txt

COPY integration_tests/ integration_tests/
COPY performance_tests/ performance_tests/

# Both suites read these to locate the running API.
ENV INTEGRATION_BASE_URL=http://api:8080
ENV PERF_BASE_URL=http://api:8080

# Default: run integration tests.
# Override at runtime for perf tests:
#   docker compose --profile tests run tests bash performance_tests/run_perf.sh
CMD ["python3", "-m", "unittest", "integration_tests.test_api", "-v"]
