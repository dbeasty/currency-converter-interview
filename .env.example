# HashiCorp Vault dev root token (must match VAULT_DEV_ROOT_TOKEN_ID in docker-compose.yml)
VAULT_TOKEN=dev-root-token

# Optional: override Postgres credentials when vault-init seeds KV (defaults: currencyconverter / ccuser / changeme)
# POSTGRES_DB=currencyconverter
# POSTGRES_USER=ccuser
# POSTGRES_PASSWORD=changeme
